            "value": "Gönder"
          }
        }
      }
    },
    "invite.copied": {
      "comment": "Row status after copying; the pasteboard item expires after 120 s (InvitePasteboard.lifetime).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied · cleared from the clipboard in 2 minutes"
          }
        },
        "tr": {

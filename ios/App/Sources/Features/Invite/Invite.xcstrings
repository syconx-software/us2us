      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Messages; you choose the recipient"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar’ı açar, alıcıyı sen seçersin"
          }
        }
      }
    },
    "a11y.invite.whatsapp": {
      "comment": "VoiceOver hint of the WhatsApp channel.",

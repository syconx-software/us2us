{
  "sourceLanguage": "tr",
  "strings": {
    "a11y.invite.copy": {
      "comment": "VoiceOver hint of “Bağlantıyı kopyala”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies your link; it is cleared from the clipboard after 2 minutes"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantını kopyalar; 2 dakika sonra panodan silinir"
          }
        }
      }
    },
    "a11y.invite.editor": {
      "comment": "VoiceOver label of the message editor.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation message"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet mesajı"
          }
        }
      }
    },
    "a11y.invite.email": {
      "comment": "VoiceOver hint of the e-mail channel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a draft email; you add the recipient"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir e-posta taslağı açar, alıcıyı sen yazarsın"
          }
        }
      }
    },
    "a11y.invite.entry": {
      "comment": "VoiceOver hint of the entry points (4.2, 7.1).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepares an invitation to us2us"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "us2us’a davet mesajı hazırlar"
          }
        }
      }
    },
    "a11y.invite.more": {
      "comment": "VoiceOver hint of “Diğer” and of the Kodum sheet's share button.",
      "extractionState": "manual",
      "localizations": {

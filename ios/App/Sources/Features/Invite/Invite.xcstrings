          "stringUnit": {
            "state": "translated",
            "value": "Opens the share sheet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşma menüsünü açar"
          }
        }
      }
    },
    "a11y.invite.preview": {

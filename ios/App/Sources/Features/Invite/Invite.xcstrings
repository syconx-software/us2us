            "state": "translated",
            "value": "Kopyalandı · 2 dakika sonra panodan silinir"
          }
        }
      }
    },
    "invite.done": {
      "comment": "Ends editing the message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "invite.edit": {
      "comment": "Starts editing the message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenle"
          }
        }
      }
    },
    "invite.entry.notFound": {
      "comment": "4.2: C1 in the not-found result card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet et"
          }
        }
      }
    },
    "invite.entry.settings": {
      "comment": "7.1 row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite a friend"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşını davet et"
          }
        }
      }
    },
    "invite.entry.share": {
      "comment": "Kodum sheet: shares the invitation through the share sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your invite link"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet bağlantını paylaş"
          }
        }
      }
    },
    "invite.message %@ %@": {
      "comment": "The invitation. %1$@ = the user's username (without @), %2$@ = https://us2us.app/u/<username>. Warm and short; the link on its own line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi! I’d like to talk with you on us2us, an app that never asks for a phone number and keeps our messages only on our two phones. My username: @%1$@\n%2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba! Seninle us2us’ta konuşmak istiyorum: telefon numarası istemeyen, mesajları yalnızca ikimizin telefonunda tutan bir uygulama. Kullanıcı adım: @%1$@\n%2$@"
          }
        }
      }
    },
    "invite.message.label": {
      "comment": "Section label above the message bubble (upper-cased by the style).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What your friend will get"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşına gidecek mesaj"
          }
        }
      }
    },
    "invite.privacy": {
      "comment": "Privacy line under the channels.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "us2us never looks at your contacts and never learns whom you invite: you choose the recipient. The link carries only your username."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "us2us rehberine bakmaz ve kimi davet ettiğini bilmez: alıcıyı sen seçersin. Bağlantıda yalnızca kullanıcı adın var."
          }
        }
      }
    },
    "invite.reset": {
      "comment": "While editing: back to the ready-made text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılana dön"
          }
        }
      }
    },
    "invite.sent": {
      "comment": "Row status after Messages / Mail / the share sheet sent it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderildi"
          }
        }
      }
    },
    "invite.subject": {
      "comment": "E-mail subject.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall we talk on us2us?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "us2us’ta konuşalım mı?"
          }
        }
      }
    },
    "invite.title": {
      "comment": "Sheet title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet et"
          }
        }
      }
    }
  },
  "version": "1.0"

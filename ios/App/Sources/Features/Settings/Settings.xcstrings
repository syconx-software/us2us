    "blocked.empty": {
      "comment": "7.1 › Engellenenler with nobody blocked (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't blocked anyone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellediğin kimse yok."
          }
        }
      }
    },
    "blocked.footnote": {
      "comment": "7.1 › Engellenenler: under the list, what a block means (PROTOCOL §6.4; proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their messages don't reach you and you can't write to them; they don't know they're blocked. The block stays even when the chat is erased. Unblocking puts things back as they were, but what they sent meanwhile won't arrive."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdıkları sana ulaşmaz, sen de onlara yazamazsın; engellendiklerini bilmezler. Sohbet silinse de engel sürer. Engeli kaldırınca her şey eskisi gibi olur, ama bu arada yazdıkları gelmez."
          }
        }
      }
    },
    "blocked.unknownUsername": {
      "comment": "7.1 › Engellenenler: under a person whose username this phone no longer keeps (a Ghost wipe with wipe_contact, PROTOCOL §8.2, kept only the block).",

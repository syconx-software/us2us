          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password can't be a single character repeated."
          }
        }
      }
    },
    "backup.problem.sequence": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola, abcdefghij ya da qwertyuiop gibi basit bir dizi olamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password can't be a simple sequence such as abcdefghij or qwertyuiop."
          }
        }
      }
    },
    "backup.problem.tooCommon": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parola çok yaygın ve kolay tahmin edilir. Başka bir parola seç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This password is too common and easy to guess. Choose another one."
          }
        }
      }
    },
    "backup.problem.tooShort": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek parolası en az 10 karakter olmalı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup password must be at least 10 characters long."
          }
        }
      }
    },
    "backup.problem.weak": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parola kolay tahmin edilir. “Güçlü parola oluştur” ile rastgele bir parola al ya da 4–5 rastgele kelimeden oluşan uzun bir parola kullan. İsim, doğum yılı ve takım adı kullanma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This password is easy to guess. Use “Generate strong password”, or a long passphrase of 4–5 random words. Avoid names, birth years and team names."
          }
        }
      }
    },

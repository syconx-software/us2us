    "settings.defaultDisappearing": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan süreli mesaj"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disappearing messages"
          }
        }
      }
    },
    "settings.defaultDisappearing.footnote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre, karşı taraf mesajı okuduğunda başlar. Süreli mesajlar kopyalanamaz ve hiçbir zaman yedeğe girmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer starts when the other person reads the message. Disappearing messages can't be copied and never go into a backup."
          }
        }
      }
    },
    "settings.defaultGhost": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan Ghost süresi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default Ghost period"
          }
        }
      }
    },
    "settings.defaultGhost.footnote": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sohbetler bu süreyle başlar. Bir sohbet bu süre boyunca sessiz kalırsa iki taraftan da silinir; her yeni mesaj süreyi baştan başlatır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New chats start with this period. If a chat stays silent this long, it's erased on both sides; every new message restarts the timer."
          }
        }
      }
    },
    "settings.disappearing.1d": {
      "extractionState": "manual",
      "localizations": {

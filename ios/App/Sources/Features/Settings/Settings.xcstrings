            "value": "Bu fotoğraf kullanılamadı. Başka bir fotoğraf dene."
          }
        }
      }
    },
    "avatar.error.save": {
      "comment": "Saving the new profile picture failed (nothing changed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile picture couldn't be saved. Try again."

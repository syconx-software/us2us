    "backup.password.generate": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güçlü parola oluştur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate strong password"
          }
        }
      },
      "comment": "7.2: fills the password field with a random password and shows it."
    },
    "backup.password.generated.hint": {
      "comment": "7.2: under the generated password card: a gentle reminder to keep it in a password manager. The copy itself is described by backup.password.copied and a11y.backup.copy.hint.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola yöneticine kaydetmeyi unutma (tireler parolanın parçası) ya da kâğıda yaz. Yedek dosyasıyla aynı yerde saklama, ekran görüntüsünü alma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember to save it in your password manager (the dashes are part of it), or write it down. Don't keep it next to the backup file, and don't take a screenshot of it."
          }
        }
      }
    },
    "backup.password.warning": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parola olmadan yedek açılamaz; biz dahil kimse kurtaramaz. Gizli kodundan farklı olmalı. Dosyayı ele geçiren biri parolayı sınırsız deneyebilir; bu yüzden uzun ve rastgele bir parola seç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without this password the backup can't be opened; no one, including us, can recover it. It must be different from your secret code. Anyone who gets the file can try passwords without limit, so choose a long, random one."
          }
        }
      }
    },
    "backup.problem.exportFailed": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek oluşturulamadı, hiçbir dosya kaydedilmedi. Tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup couldn't be created, and nothing was saved. Try again."
          }
        }
      }
    },
    "backup.problem.mismatch": {
      "extractionState": "manual",
      "localizations": {

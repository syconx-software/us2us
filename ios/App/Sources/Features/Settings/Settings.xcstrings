      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Immediately"
          }
        }
      }
    },
    "settings.avatarSearch": {
      "comment": "7.1 › Gizlilik: switch — the profile picture is shown to anyone who looks up the exact username (PROTOCOL §8.10).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in search"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aramada göster"
          }
        }
      }
    },
    "settings.avatarSearch.footnote": {
      "comment": "7.1 › Gizlilik footnote: what “Aramada göster” means (wording fixed by PROTOCOL §8.10).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, anyone who types your exact username can see your profile picture. When off, only your contacts see it. Turning it off doesn't remove copies others already fetched, and the server can open the picture by guessing your username."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken kullanıcı adını tam olarak yazan herkes profil resmini görebilir. Kapalıyken yalnızca kişilerin görür. Kapatman, daha önce görenlerdeki kopyaları silmez; sunucu da kullanıcı adını tahmin ederek resmi açabilir."
          }
        }
      }
    },
    "settings.avatarSearch.pending": {
      "comment": "7.1 › Gizlilik footnote, second line: a picture or “Aramada göster” change is still owed to the relay.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last change hasn't reached the server yet; it's tried again once you're connected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son değişiklik sunucuya henüz ulaşmadı; bağlantı kurulunca yeniden denenir."
          }
        }
      }
    },
    "settings.avatarSearch.unavailable": {
      "comment": "7.1 › Gizlilik footnote, second line: the relay has no avatar records yet (404/405).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn't show pictures in search yet; your contacts still see yours."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu şimdilik aramada resim göstermiyor; kişilerin resmini yine görür."
          }
        }
      }
    },

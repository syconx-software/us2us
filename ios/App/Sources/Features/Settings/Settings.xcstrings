{
  "sourceLanguage": "tr",
  "strings": {
    "a11y.backup.copy.hint": {
      "comment": "7.2: VoiceOver hint of “Kopyala” on the generated password (local only, expires after 60 s).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu cihazın panosuna kopyalar; 1 dakika sonra silinir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies to this device's clipboard only; it's cleared after 1 minute."
          }
        }
      }
    },
    "a11y.backup.generated": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturulan parola"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated password"
          }
        }
      },
      "comment": "7.2: VoiceOver label of the generated backup password shown under the field; the value spells it out."
    },
    "a11y.backup.generated.hidden": {
      "comment": "7.2: VoiceOver value of the generated password while it is hidden (until “Göster”).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden"
          }
        }
      }
    },
    "a11y.backup.strength": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola gücü"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password strength"
          }
        }
      }
    },
    "a11y.ownQR": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi QR kodun"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your QR code"
          }
        }
      }
    },
    "a11y.restore.fileOK": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek dosyası uygun"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup file is valid"
          }
        }
      }
    },
    "about.licences": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisanslar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Licences"
          }
        }
      }
    },
    "about.principle.code": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli kod cihazdan çıkmaz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your code never leaves"
          }
        }
      }
    },
    "about.principle.code.detail": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir yere gönderilmez, hiçbir yerde saklanmaz ve sıfırlanamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's never sent or stored anywhere, and it can't be reset."
          }
        }
      }
    },
    "about.principle.e2e": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçtan uca şifreli"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted"
          }
        }
      }
    },
    "about.principle.e2e.detail": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu yalnızca açamadığı zarfları taşır; 14 gün içinde alınmayan silinir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server only carries envelopes it can't open; anything not fetched within 14 days is deleted."
          }
        }
      }
    },
    "about.principle.noNotifications": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim yok. Bilerek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notifications. On purpose."
          }
        }
      }
    },
    "about.principle.noNotifications.detail": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar yalnızca uygulama açıkken gelir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages arrive only while the app is open."
          }
        }
      }
    },
    "about.principle.noTracking": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numara, reklam, takip yok"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No number, no ads, no tracking"
          }
        }
      }
    },
    "about.principle.noTracking.detail": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon numarası istemez, rehberini yüklemez; analiz ve reklam yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No phone number, no contact upload; no analytics, no ads."
          }
        }
      }
    },
    "about.principles": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlkeler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Principles"
          }
        }
      }
    },
    "about.privacyPolicy": {
      "comment": "7.1 › Hakkında: opens the privacy policy on us2us.app in the browser (App Review 5.1.1(i)).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy policy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik politikası"
          }
        }
      }
    },
    "about.support": {
      "comment": "7.1 › Hakkında: opens the support page (FAQ, e-mail) on us2us.app in the browser.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destek"
          }
        }
      }
    },
    "about.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        }
      }
    },
    "about.version %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm %1$@ (%2$@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ (%2$@)"
          }
        }
      }
    },
    "about.website": {
      "comment": "7.1 › Hakkında, section label over the links to the website (us2us.app).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Website"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web sitesi"
          }
        }
      }
    },
    "access.closed.toast": {
      "comment": "7.1 toast: the server confirmed the rotation; the notice is gone.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski telefonun erişimi kapandı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your old phone no longer has access."
          }
        }
      }
    },
    "access.notice.body": {
      "comment": "7.1 top notice body: honest about what an unanswered rotation means; it disappears once the outcome is known.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme sırasında, eski telefonunun erişimini kapatma isteğine sunucudan yanıt gelmedi. Bu doğrulanana kadar eski telefon hesabına bağlanıp sana yazılanları alabilir; bu telefon ise bağlanmaz. Uygulama her bağlanmaya çalıştığında yeniden sorar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During the restore, the server didn't answer the request that closes your old phone's access. Until that's confirmed, the old phone may still connect to your account and receive messages sent to you, and this phone doesn't connect. The app asks again every time it tries to connect."
          }
        }
      }
    },
    "access.notice.check": {
      "comment": "7.1 notice: asks the server now whether the rotation went through.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi kontrol et"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check now"
          }
        }
      }
    },
    "access.notice.checking": {
      "comment": "7.1 notice: the button while the server is asked.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol ediliyor…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        }
      }
    },
    "access.notice.title": {
      "comment": "7.1 top notice (proposed): after a restore, the server never answered the token rotation that closes the old phone’s access (PROTOCOL §5.5 step 3.4).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski telefonun erişimi kapanmamış olabilir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your old phone may still have access"
          }
        }
      }
    },
    "access.notice.unanswered": {
      "comment": "7.1 notice, under its text after “Şimdi kontrol et” got no answer.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucudan yine yanıt gelmedi. Bağlantını kontrol edip tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still no answer from the server. Check your connection and try again."
          }
        }
      }
    },
    "access.refused.toast": {
      "comment": "7.1 toast: the server refused both tokens (another phone restored the same backup first, or the account was deleted).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon artık hesabına bağlanamıyor: yedek başka bir telefonda geri yüklenmiş ya da hesap silinmiş."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can no longer connect to your account: the backup was restored on another phone, or the account was deleted."
          }
        }
      }
    },
    "avatar.camera.denied": {
      "comment": "7.1 › Profil görseli › Kamera when camera access was denied (toast).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off. You can turn it on in Settings › us2us."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera izni kapalı. Ayarlar › us2us'tan açabilirsin."
          }
        }
      }
    },
    "avatar.camera.denied.body": {
      "comment": "Body of the camera-access sheet (7.1 › Profil görseli › Kamera).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To take a profile photo, allow camera access in Settings. us2us uses the camera only when you open it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil fotoğrafı çekmek için Ayarlar'dan kamera iznini açabilirsin. us2us kamerayı yalnızca sen açtığında kullanır."
          }
        }
      }
    },
    "avatar.camera.denied.title": {
      "comment": "Title of the sheet shown when camera access was denied (7.1 › Profil görseli › Kamera).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera izni kapalı"
          }
        }
      }
    },
    "avatar.camera.restricted": {
      "comment": "7.1 › Profil görseli › Kamera when the camera is restricted on the device (Screen Time, a profile).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is restricted on this device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera bu cihazda kısıtlanmış."
          }
        }
      }
    },
    "avatar.camera.settings": {
      "comment": "Camera-access sheet: opens the app's page in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları aç"
          }
        }
      }
    },
    "avatar.camera.unavailable": {
      "comment": "7.1 › Profil görseli › Kamera on a device without a camera (simulator).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera isn't available on this device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda kamera kullanılamıyor."
          }
        }
      }
    },
    "avatar.crop.area": {
      "comment": "VoiceOver label of the framing viewport (the photo inside the circle).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The part your profile shows"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilinde görünecek kısım"
          }
        }
      }
    },
    "avatar.crop.area.hint": {
      "comment": "VoiceOver hint of the framing viewport (adjustable).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up or down to zoom in or out. Use the actions to move the frame."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınlaştırmak ya da uzaklaştırmak için yukarı ya da aşağı kaydır. Çerçeveyi taşımak için eylemleri kullan."
          }
        }
      }
    },
    "avatar.crop.hint": {
      "comment": "Framing screen: hint under the viewport.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move, pinch to zoom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükleyerek kaydır, iki parmakla büyüt."
          }
        }
      }
    },
    "avatar.crop.move.down": {
      "comment": "VoiceOver action on the framing screen's square (Fotoğrafı yerleştir): moves the framed part of the photo.",

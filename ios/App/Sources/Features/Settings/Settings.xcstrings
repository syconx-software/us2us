    "about.principle.code": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli kod cihazdan çıkmaz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your code never leaves"
          }
        }
      }
    },
    "about.principle.code.detail": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu cihazda, şifreli olarak durur. Sıfırlanamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It lives only on this device, encrypted. It can't be reset."
          }
        }
      }
    },
    "about.principle.e2e": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçtan uca şifreli"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted"
          }
        }
      }
    },
    "about.principle.e2e.detail": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu yalnızca açamadığı zarfları taşır; 14 gün içinde alınmayan silinir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server only carries envelopes it can't open; anything not fetched within 14 days is deleted."
          }
        }
      }
    },
    "about.principle.noNotifications": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim yok. Bilerek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notifications. On purpose."
          }
        }
      }
    },
    "about.principle.noNotifications.detail": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar yalnızca uygulama açıkken gelir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages arrive only while the app is open."
          }
        }
      }
    },
    "about.principle.noTracking": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",

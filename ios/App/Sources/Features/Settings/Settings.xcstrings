    "settings.erase": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şeyi sil"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase everything"
          }
        }
      }
    },
    "settings.erase.confirm.action": {
      "comment": "7.1 erase confirmation, the danger button: deletes the account on the relay, then this phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account and everything"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı ve her şeyi sil"
          }
        }
      }
    },
    "settings.erase.confirm.body": {
      "comment": "7.1 “Her şeyi sil” second confirmation paragraph: the account is deleted on the relay too (the relay frees the username at once, PROTOCOL §4.3).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın ve kullanıcı adın sunucudan; sohbetlerin, anahtarların ve ayarların bu telefondan kalıcı olarak silinecek. Artık kimse sana ulaşamayacak ve kullanıcı adın hemen serbest kalacak. Bu işlem geri alınamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and username will be permanently deleted from the server, and your chats, keys and settings from this phone. No one will be able to reach you, and your username will be free for others right away. This can't be undone."
          }
        }
      }
    },
    "settings.erase.confirm.title": {
      "comment": "7.1 “Her şeyi sil” second confirmation title (Doto display): the account is deleted on the relay too. 3.3's local-only confirmation keeps “Her şey silinsin mi?” (erase.confirm.title).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın silinsin mi?"
          }
        }
      }
    },
    "settings.erase.confirm.working": {
      "comment": "7.1 erase confirmation: the danger button (or “Tekrar dene”) while the relay deletes the account.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap siliniyor…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting account…"
          }
        }
      }
    },
    "settings.erase.failed.body": {
      "comment": "7.1 erase sheet when the relay did not confirm the deletion (offline, timeout, server error). Only this phone is known to be untouched: the relay may have deleted the account just before the connection dropped (“Tekrar dene” then succeeds).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't confirm the deletion. Nothing on this phone was erased; check your connection and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucudan silme onayı gelmedi. Bu telefonda hiçbir şey silinmedi; bağlantını kontrol edip tekrar dene."
          }
        }
      }
    },
    "settings.erase.failed.title": {
      "comment": "7.1 erase sheet title when the relay did not delete the account (Doto display).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap silinemedi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account wasn't deleted."
          }
        }
      }
    },
    "settings.erase.footnote": {
      "comment": "7.1 under “Her şeyi sil”. A restore needs the account on the relay, so a deleted account cannot come back from a backup; exported backup files stay where the user saved them.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and username are permanently deleted from the server, and your chats, keys and settings from this phone. A deleted account can't be restored from a backup either. Backup files you exported stay in Files and can no longer be used; you can delete them yourself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın ve kullanıcı adın sunucudan; sohbetlerin, anahtarların ve ayarların bu telefondan kalıcı olarak silinir. Silinen hesap yedekten de geri gelmez. Dışa aktardığın yedek dosyaları Dosyalar’da kalır ve artık kullanılamaz; onları kendin silebilirsin."
          }
        }
      }
    },
    "settings.erase.retry": {
      "comment": "7.1 erase sheet after a failure: deletes the account on the relay again.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar dene"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "settings.erase.thisPhone.body": {
      "comment": "7.1 erase sheet after a failure, option card description. Contacts can still write to the abandoned account; their messages never arrive. 180 = the relay's INACTIVE_ACCOUNT_DAYS (PROTOCOL §4.10).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and username stay on the server, and messages sent to you won't reach you. The account is removed automatically after 180 days without a connection."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın ve kullanıcı adın sunucuda kalır; sana yazılanlar sana ulaşmaz. Hesap, 180 gün hiç bağlanılmazsa kendiliğinden silinir."
          }
        }
      }
    },
    "settings.erase.thisPhone.title": {
      "comment": "7.1 erase sheet after a failure, danger option card: erases this phone, leaves the account on the relay.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu telefondan sil"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase from this phone only"
          }
        }
      }
    },

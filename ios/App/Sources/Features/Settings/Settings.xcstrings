          "stringUnit": {
            "state": "translated",
            "value": "Aktif durumu karşılıklıdır: göstermediğini başkalarından da göremezsin. Mesaj isteği gönderenler onu hiçbir zaman görmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity status is mutual: you can't see what you don't show. People who send you a request never see it."
          }
        }
      }
    },
    "settings.presence.nobody": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody"
          }
        }
      }
    },
    "settings.presence.nobody.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimse görmez; sen de kimsenin aktif durumunu görmezsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody sees it, and you don't see anyone else's either."
          }
        }
      }

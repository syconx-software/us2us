    "backup.password.warning": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parola olmadan yedek açılamaz; biz dahil kimse kurtaramaz. Gizli kodundan farklı olmalı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without this password the backup can't be opened; no one, including us, can recover it. It must be different from your secret code."
          }
        }
      }
    },

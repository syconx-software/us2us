    "restore.note.account": {
      "comment": "7.3 note once an account backup was opened on a phone without an account: what really comes back (PROTOCOL §5.5).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın ve kişilerin geri gelir; mesaj geçmişi yedekte yok. Geri yüklenen dosya bundan sonra çalışmaz; ardından yeni bir yedek al. Son adım: bu cihaz için yeni bir gizli kod belirle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and contacts come back; message history isn't in the backup. This file stops working once it's restored, so take a new backup afterwards. One last step: set a new secret code for this device."
          }
        }
      }
    },
    "restore.note.account.replacing": {
      "comment": "7.3 note once an account backup was opened inside the lock (3.3): what comes back, and that this phone's messages are erased when setup finishes.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın ve kişilerin geri gelir; mesaj geçmişi yedekte yok. Kurulumu tamamladığında bu telefondaki mesajlar silinir ve bu dosya artık çalışmaz; ardından yeni bir yedek al. Son adım: yeni bir gizli kod belirle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and contacts come back; message history isn't in the backup. When you finish setup, the messages on this phone are erased and this file stops working, so take a new backup afterwards. One last step: set a new secret code."
          }
        }
      }
    },
    "restore.note.done": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetlerin geri geldi. Son adım: bu cihaz için yeni bir gizli kod belirle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chats are back. One last step: set a new secret code for this device."
          }
        }
      }
    },
    "restore.note.private": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çözme tamamen bu cihazda yapılır; dosya ve parola hiçbir yere gönderilmez."

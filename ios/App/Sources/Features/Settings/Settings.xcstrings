    "code.unusable": {
      "comment": "7.1 › Gizli kodu değiştir: the vault can no longer be opened on this phone once the app locks (device secret or hardware key gone). The app is still open, so a new backup keeps the account.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon, uygulama kilitlendikten sonra verilerinin kilidini açamayacak. Uygulama açıkken Ayarlar › Yedek'ten yeni bir yedek al."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone won't be able to unlock your data once the app locks. While it's open, take a new backup in Settings › Backup."
          }
        }
      }
    },

            "value": "SOHBET ARKA PLANI"
          }
        }
      }
    },
    "background.note": {
      "comment": "Under the swatches: where the background is kept.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown only on this phone. It is not sent to anyone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu telefonda görünür, karşı tarafa gönderilmez."
          }
        }
      }
    },

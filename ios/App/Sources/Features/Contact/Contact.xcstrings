            "value": "Fotoğraflar"
          }
        }
      }
    },
    "tab.verification": {
      "comment": "Contact screen tab: the safety number (6.1).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulama"
          }

    "background.problem.photo": {
      "comment": "The picked photo could not be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo could not be used. Try another one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf kullanılamadı. Başka bir fotoğraf dene."
          }
        }
      }
    },
    "background.problem.save": {
      "comment": "Saving the background failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background could not be saved. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan kaydedilemedi. Yeniden dene."
          }
        }
      }
    },
    "background.sample.incoming": {
      "comment": "Preview bubble: an incoming message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, how are you?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba, nasılsın?"
          }
        }
      }
    },
    "background.sample.outgoing": {
      "comment": "Preview bubble: an outgoing message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good, how about you?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyiyim, sen nasılsın?"
          }
        }
      }
    },
    "background.standard": {
      "comment": "VoiceOver: the swatch of the app’s own background.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan"
          }
        }
      }
    },
    "blocked.message": {
      "comment": "Contact screen › Doğrulama, the note while the person is blocked (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their messages don't reach you and you can't write to them. They don't know they're blocked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdıkları sana ulaşmaz, sen de ona yazamazsın. Engellendiğini bilmez."
          }
        }
      }
    },
    "blocked.title %@": {
      "comment": "Contact screen › Doğrulama, the note while the person is blocked (proposed). %@ = the contact's username.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is blocked"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ engellendi"
          }
        }
      }
    },
    "documents.empty.body %@": {
      "comment": "Contact screen › Belgeler, nothing yet. %@ = the contact's username.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files you share with %@ will show up here. Files in disappearing messages don't."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile paylaştığınız dosyalar burada görünür. Süreli mesajlardaki dosyalar burada görünmez."
          }
        }
      }
    },
    "documents.empty.title": {
      "comment": "Contact screen › Belgeler, nothing yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No documents yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz belge yok"
          }
        }
      }
    },
    "documents.sender.you": {
      "comment": "Contact screen › Belgeler: who sent a file, the user themselves (lower case, like the usernames).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "you"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sen"
          }
        }
      }
    },
    "menu.background": {
      "comment": "The contact screen’s “…” menu and a community’s management sheet: this chat’s own background.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat background"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet arka planı"
          }
        }
      }
    },
    "menu.share": {
      "comment": "Contact screen “…” menu, on Doğrulama: shares the safety number's digits as text (6.1's share).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share number"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numarayı paylaş"
          }
        }
      }
    },
    "photos.empty.body %@": {
      "comment": "Contact screen › Fotoğraflar, nothing yet. %@ = the contact's username.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and videos you share with %@ will show up here. View-once and disappearing ones don't."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile paylaştığınız fotoğraf ve videolar burada görünür. Tek seferlik ve süreli olanlar burada görünmez."
          }
        }
      }
    },
    "photos.empty.title": {
      "comment": "Contact screen › Fotoğraflar, nothing yet.",

{
  "sourceLanguage": "tr",
  "strings": {
    "a11y.blocked %@": {
      "comment": "VoiceOver announcement after Engelle on the contact screen. %@ = the contact's username.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is blocked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ engellendi."
          }
        }
      }
    },
    "a11y.loadingMore": {
      "comment": "VoiceOver: the next page of photos or documents is loading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading more"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazlası yükleniyor"
          }
        }
      }
    },
    "a11y.more": {
      "comment": "VoiceOver label of the contact screen's “…” header button (share · Bildir · Engelle).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer"
          }
        }
      }
    },
    "a11y.photo %@ %@": {
      "comment": "VoiceOver label of a photo tile on the contact screen: the sender (username or “sen”) and the day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo, %1$@, %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf, %1$@, %2$@"
          }
        }
      }
    },
    "a11y.unblock.hint": {
      "comment": "VoiceOver hint of “Engeli kaldır” in the contact screen's blocked note.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaging opens again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlaşma yeniden açılır"
          }
        }
      }
    },
    "a11y.unblocked %@": {
      "comment": "VoiceOver announcement after “Engeli kaldır” on the contact screen. %@ = the contact's username.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is no longer blocked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ artık engelli değil."
          }
        }
      }
    },
    "a11y.video %@ %@ %@": {
      "comment": "VoiceOver label of a video tile on the contact screen: its length, the sender (username or “sen”) and the day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, %1$@, %2$@, %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video, %1$@, %2$@, %3$@"
          }
        }
      }
    },
    "background.kicker": {
      "comment": "Kicker of the chat background sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CHAT BACKGROUND"

      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To record voice messages, allow microphone access for us2us in Settings. The microphone is on only while you record, and a recording leaves your phone only if you send it, end-to-end encrypted."

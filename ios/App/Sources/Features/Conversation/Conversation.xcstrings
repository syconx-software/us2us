    "ghost.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the chat stays this quiet, it's erased completely from both ends. Every new message restarts the timer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet bu kadar sessiz kalırsa iki uçtan da tamamen silinir. Her yeni mesaj sayacı baştan başlatır."
          }
        }
      }
    },

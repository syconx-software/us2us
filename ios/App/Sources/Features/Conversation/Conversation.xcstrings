          "stringUnit": {
            "state": "translated",
            "value": "They saved this"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşı taraf kaydetti"
          }
        }
      }
    },
    "confirm.deleteEveryone.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A “This message was deleted for everyone” trace stays in its place."

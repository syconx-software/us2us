    "info.failed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not opened within 14 days"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 gün içinde açılmadı"
          }
        }
      }
    },
    "info.note.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the recipient doesn't open the app within 14 days, the message is deleted from the server and never reaches them. “Send again” appears under the message."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcı 14 gün içinde uygulamayı açmazsa mesaj sunucudan silinir ve ona hiç ulaşmaz. Mesajın altında “Tekrar gönder” belirir."
          }
        }
      }
    },
    "info.note.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does “not delivered” mean?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İletilemedi ne demek?"
          }
        }
      }
    },

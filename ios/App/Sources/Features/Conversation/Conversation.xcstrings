            "value": "Message actions"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj eylemleri"
          }
        }
      }
    },
    "a11y.reactions.more": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More reactions"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazla tepki"
          }
        }
      }
    },
    "a11y.typing %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is typing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yazıyor"
          }
        }
      }
    },
    "actions.copy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyala"
          }
        }
      }
    },
    "actions.copy.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off for disappearing messages"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreli mesajda kapalı"
          }
        }
      }
    },
    "actions.deleteEveryone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for everyone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkesten sil"
          }
        }
      }
    },
    "actions.deleteMe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for me"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benden sil"
          }
        }
      }
    },
    "actions.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgi"
          }
        }
      }
    },
    "actions.reply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtla"
          }
        }
      }
    },
    "attach.file": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya"
          }
        }
      }
    },
    "confirm.deleteEveryone.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A “This message was deleted for everyone” trace stays in its place."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerinde “Bu mesaj herkesten silindi” izi kalır."
          }
        }
      }
    },
    "confirm.deleteEveryone.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this message for everyone?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj iki taraftan da silinsin mi?"
          }
        }
      }
    },
    "disappearing.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New messages are deleted the chosen time after they're read."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni mesajlar, okunduktan sonra seçtiğin sürede silinir."
          }
        }
      }
    },
    "disappearing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disappearing messages"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreli mesajlar"
          }
        }
      }
    },
    "ghost.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the chat stays this quiet, it's erased completely from both ends. Every new message restarts the timer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet bu kadar sessiz kalırsa iki uçtan da tamamen silinir. Her yeni mesaj sayacı baştan başlatır."
          }
        }
      }
    },
    "ghost.kicker %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghost mode · %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghost mod · %@"
          }
        }
      }
    },
    "ghost.silence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silence period"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessizlik süresi"
          }
        }
      }
    },
    "ghost.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghost mode"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghost mod"
          }
        }
      }
    },
    "info.delivered.detail %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opened the app; the message is now on their device"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamayı açtı, mesaj artık onun cihazında"
          }
        }
      }
    },
    "info.failed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not opened within 14 days"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 gün içinde açılmadı"
          }
        }
      }
    },
    "info.note.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the recipient doesn't open the app within 14 days, the message is deleted from the server and never reaches them. “Send again” appears under the message."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcı 14 gün içinde uygulamayı açmazsa mesaj sunucudan silinir ve ona hiç ulaşmaz. Mesajın altında “Tekrar gönder” belirir."
          }
        }
      }
    },
    "info.note.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does “not delivered” mean?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İletilemedi ne demek?"
          }
        }
      }
    },
    "info.read.detail %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opened the message"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mesajı açtı"
          }
        }
      }
    },
    "info.sent.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left your device; the server only carries the sealed envelope"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazından çıktı; sunucu yalnızca kapalı zarfı taşıyor"
          }
        }
      }
    },
    "info.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message info"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj bilgisi"
          }
        }
      }
    },
    "viewOnce.badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 kez"
          }
        }
      }
    },
    "viewOnce.captured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden while the screen is being recorded"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kaydı sırasında gizlendi"
          }
        }
      }
    },
    "viewOnce.closeDeletes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted when you close it"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatınca silinir"
          }
        }
      }
    },
    "viewOnce.footer.photo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo can't be opened again and never goes into a backup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraf yeniden açılamaz ve yedeğe girmez."
          }
        }
      }
    },
    "viewOnce.footer.video": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video can't be opened again and never goes into a backup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu video yeniden açılamaz ve yedeğe girmez."
          }
        }
      }
    },
    "viewOnce.screenshot.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been told. iOS doesn't block screenshots; we can only let them know."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bildirildi. iOS ekran görüntüsünü engellemiyor; yalnızca haber verebiliyoruz."
          }
        }
      }
    },
    "viewOnce.screenshot.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot detected"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüsü algılandı"
          }
        }
      }
    },
    "viewOnce.today %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}

    "blocked.bar %@": {
      "comment": "5.1 of a blocked person (proposed): the bar in the composer's place, above “Engeli kaldır”. %@ = username.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is blocked. Their messages don't reach you and you can't write to them; they don't know they're blocked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ engellendi. Yazdıkları sana ulaşmaz, sen de ona yazamazsın; engellendiğini bilmez."
          }
        }
      }
    },
    "blocked.unblock.hint": {
      "comment": "VoiceOver hint of “Engeli kaldır” in the 5.1 blocked bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaging opens again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlaşma yeniden açılır"
          }
        }
      }
    },
    "bubble.saved": {
      "comment": "The chip under the user's own photo, video or file once the other side saved it (SAVED receipt). Short, like a reaction chip.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetti"
          }
        }
      }
    },
    "bubble.saved.a11y": {
      "comment": "VoiceOver: the “Kaydetti” chip.",
      "extractionState": "manual",
      "localizations": {

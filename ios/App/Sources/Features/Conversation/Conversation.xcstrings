        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli mesaj kaydetmek için Ayarlar’da us2us’a mikrofon izni ver. Mikrofon yalnızca sen kayıt yaparken açılır; kayıt yalnızca sen gönderirsen, uçtan uca şifreli gider."
          }
        }
      }

    "a11y.header.peer.hint": {
      "comment": "VoiceOver hint of the person in the chat header (opens the contact screen).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens verification, photos and documents"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulamayı, fotoğrafları ve belgeleri açar"

    "a11y.request.delete.hint": {
      "comment": "VoiceOver hint of a request's “Sil”.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteği kaldırır. Gönderen bunu bilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the request. The sender won't know."
          }

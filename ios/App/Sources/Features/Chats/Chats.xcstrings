{
  "sourceLanguage": "tr",
  "strings": {
    "a11y.more": {
      "comment": "VoiceOver label of the “…” header buttons (4.3, 4.4).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer"
          }
        }
      }
    },
    "a11y.request.open": {
      "comment": "VoiceOver hint of a request card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the request"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteği açar"
          }
        }
      }
    },
    "access.card.subtitle": {
      "comment": "4.1 card subtitle: 7.1 explains and has “Şimdi kontrol et”.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıntılar ve yeniden kontrol için dokun"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap for details and to check again"
          }
        }
      }
    },
    "access.card.title": {
      "comment": "4.1 card (proposed), only after a restore whose token rotation the server never answered (PROTOCOL §5.5 step 3.4); opens 7.1.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski telefonun erişimi kapanmamış olabilir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your old phone may still have access"
          }
        }
      }
    },
    "list.empty": {
      "comment": "4.1 empty list (proposed copy).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chats yet. Start by typing someone's exact username."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sohbet yok. Birinin kullanıcı adını tam yazarak başla."
          }
        }
      }
    },
    "list.empty.action": {
      "comment": "4.1 empty list: opens 4.2.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New chat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sohbet"
          }
        }
      }
    },
    "media.file": {
      "comment": "Media kind (proposed list in 4.1).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya"
          }
        }
      }
    },
    "newChat.existing": {
      "comment": "4.2 result for an existing contact (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have a chat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten sohbetiniz var"
          }
        }
      }
    },
    "newChat.found": {
      "comment": "4.2 result card subtitle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User found"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı bulundu"
          }
        }
      }
    },
    "newChat.info %@ %@": {
      "comment": "4.2 info row. %1$@ = username, %2$@ = newChat.info.requests (emphasised).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until %1$@ accepts you, your first message waits in their %2$@. Until then, neither of you can see the other's activity."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ seni kabul edene kadar ilk mesajın onun %2$@ kutusunda bekler. O zamana kadar aktif durumunuzu birbirinizden göremezsiniz."
          }
        }
      }
    },
    "newChat.info.requests": {
      "comment": "Emphasised part of newChat.info (must appear verbatim in it).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message requests"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj istekleri"
          }
        }
      }
    },
    "newChat.invalid.characters": {
      "comment": "4.2 result for a name that breaks a username rule (PROTOCOL §3.1): nobody can have it, so it is not searched. After “·” the rule, as on 2.1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a valid username · Only lower-case letters, digits and underscore."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz kullanıcı adı · Yalnızca küçük harf, rakam ve alt çizgi."
          }
        }
      }
    },
    "newChat.invalid.firstLetter": {
      "comment": "4.2 result for a name that breaks a username rule (PROTOCOL §3.1): nobody can have it, so it is not searched. After “·” the rule, as on 2.1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a valid username · Must start with a letter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz kullanıcı adı · Harfle başlamalı."
          }
        }
      }
    },
    "newChat.invalid.tooLong": {
      "comment": "4.2 result for a name that breaks a username rule (PROTOCOL §3.1): nobody can have it, so it is not searched. After “·” the rule, as on 2.1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a valid username · At most 24 characters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz kullanıcı adı · En fazla 24 karakter."
          }
        }
      }
    },
    "newChat.invalid.turkish": {
      "comment": "4.2 result for a name that breaks a username rule (PROTOCOL §3.1): nobody can have it, so it is not searched. After “·” the rule, as on 2.1.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a valid username · Turkish characters can't be used."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz kullanıcı adı · Türkçe karakter kullanılamaz."
          }
        }
      }
    },
    "newChat.notFound": {
      "comment": "4.2 not found (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User not found · Check that you typed the full username."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı bulunamadı · Adı eksiksiz yazdığından emin ol."
          }
        }
      }
    },
    "newChat.openChat": {
      "comment": "4.2 primary button for an existing contact (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to chat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbete git"
          }
        }
      }
    },
    "newChat.own": {
      "comment": "4.2 when the user types their own name (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's your own username"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu senin kullanıcı adın"
          }
        }
      }
    },
    "newChat.placeholder": {
      "comment": "4.2 empty search field placeholder (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "username"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kullanıcı adı"
          }
        }
      }
    },
    "newChat.searching": {
      "comment": "4.2 while the exact lookup runs (VoiceOver label of the spinner).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aranıyor…"
          }
        }
      }
    },
    "newChat.write": {
      "comment": "4.2 primary button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a message"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj yaz"
          }
        }
      }
    },
    "preview.avatar.none": {
      "comment": "4.4 after “Profil resmini göster” found no picture for the sender.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No profile picture."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil resmi yok."
          }
        }
      }
    },
    "preview.avatar.show": {
      "comment": "4.4 text button under the profile block: fetches the sender's profile picture once (never automatically, PROTOCOL §8.9).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show picture"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil resmini göster"
          }
        }
      }
    },
    "preview.avatar.show.hint": {
      "comment": "VoiceOver hint of “Profil resmini göster” on 4.4.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets the sender's profile picture once. The server sees that you looked at this account's picture; it's never loaded on its own before you accept."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderenin profil resmini bir kez getirir. Sunucu, bu hesabın resmine baktığını görür; kabul etmeden önce resim kendiliğinden yüklenmez."
          }
        }
      }
    },
    "preview.avatar.show.note": {
      "comment": "4.4: the line under “Profil resmini göster” (the fetch tells the relay who probably sent the request, PROTOCOL §9).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sees that you looked at this account's picture."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu, bu hesabın resmine baktığını görür."
          }
        }
      }
    },
    "preview.avatar.shown.a11y": {
      "comment": "4.4: VoiceOver announcement after “Profil resmini göster” found a picture; follows the username.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile picture shown"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil resmi gösteriliyor"
          }
        }
      }
    },
    "preview.date.today %@": {
      "comment": "4.4 date separator (shown upper-cased). %@ = HH:mm.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün %@"
          }
        }
      }
    },
    "preview.date.yesterday %@": {
      "comment": "4.4 date separator (shown upper-cased). %@ = HH:mm.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dün %@"
          }
        }
      }
    },
    "preview.decision %@": {
      "comment": "4.4 decision bar. %@ = username.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you accept, the chat opens and you can reply. %@ won't know you've seen the request."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabul edersen sohbet açılır ve yanıt yazabilirsin. %@ isteği gördüğünü bilmez."
          }
        }
      }
    },
    "preview.intro": {
      "comment": "4.4 profile block.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't talked before. They found you by typing your exact username."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha önce yazışmadınız. Seni kullanıcı adını tam yazarak buldu."
          }
        }
      }
    },
    "preview.link.inert": {
      "comment": "4.4 link bubble caption.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link won't open until you accept"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı, kabul edene kadar açılmaz"
          }
        }
      }
    },
    "qr.add": {
      "comment": "4.1 QR menu and 4.2 option row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add with QR code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QR kodla ekle"
          }
        }
      }
    },
    "qr.add.subtitle": {
      "comment": "4.2 option row subtitle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side by side, it adds and verifies at once"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yan yanaysanız ekler ve aynı anda doğrular"
          }
        }
      }
    },
    "qr.mine": {
      "comment": "4.1 QR menu and 4.2 option row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show my code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodumu göster"
          }
        }
      }
    },
    "requests.age.days %lld": {
      "comment": "4.3 request age: “3 gün”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld gün"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld gün"
                }
              }
            }
          }
        }
      }
    },
    "requests.age.hours %lld": {
      "comment": "4.3 request age: “2 sa”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld h"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sa"
          }
        }
      }
    },
    "requests.age.minutes %lld": {
      "comment": "4.3 request age under an hour.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dk"
          }
        }
      }
    },
    "requests.banner": {
      "comment": "4.3 privacy banner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chat won't open until you accept, and they can't see your activity or reads. If you delete or block, they won't know."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabul edene kadar sohbet açılmaz; okuduğunu ve aktif olduğunu göremezler. Silersen ya da engellersen bunu bilmezler."
          }
        }
      }
    },
    "requests.block.message": {
      "comment": "Block confirmation message of 4.3/4.4 and of the contact screen (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They can't message you again. They won't know they were blocked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana bir daha yazamaz. Engellendiğini bilmez."
          }
        }
      }
    },
    "requests.block.title %@": {
      "comment": "Block confirmation of 4.3/4.4 and of the contact screen (proposed). %@ = username.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block %@?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ engellensin mi?"
          }
        }
      }
    },
    "requests.deleteAll.confirm": {
      "comment": "4.3 confirmation button (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü sil"
          }
        }
      }
    },
    "requests.deleteAll.message": {
      "comment": "4.3 confirmation message (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The senders won't know."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderenler bunu bilmez."
          }
        }
      }
    },
    "requests.deleteAll.title": {
      "comment": "4.3 confirmation (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all requests?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm istekler silinsin mi?"
          }
        }
      }
    },
    "requests.empty": {
      "comment": "4.3 empty (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pending requests."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen istek yok."
          }
        }
      }
    },
    "requests.flag.link": {
      "comment": "4.3 flag.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contains a link · won't open"
          }
        },
        "tr": {

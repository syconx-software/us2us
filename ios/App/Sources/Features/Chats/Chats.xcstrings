    "requests.flag.media": {
      "comment": "4.3 flag / 4.4 media placeholder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media hidden until you accept"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya kabul edene kadar gizli"
          }
        }
      }
    },
    "requests.flag.suspicious": {
      "comment": "4.3 flag for suspicious requests without a link (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspicious content"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şüpheli içerik"
          }
        }
      }
    },
    "requests.menu.deleteAll": {
      "comment": "4.3 “…” menu (proposed).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü sil"
          }
        }

        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topluluktan ayrılınsın mı?"
          }
        }
      }
    },
    "confirm.remove.message": {
      "comment": "Remove-member confirmation body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They will no longer send or receive new messages. Messages they already received cannot be recalled."

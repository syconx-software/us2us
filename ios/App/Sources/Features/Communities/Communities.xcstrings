          "stringUnit": {
            "state": "translated",
            "value": "Remove from this phone?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefondan kaldırılsın mı?"
          }
        }
      }
    },
    "confirm.leave.message": {
      "comment": "Leave confirmation body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will no longer send or receive its messages. The community and its messages are erased from this phone; coming back needs a new request."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık mesaj alamaz ve gönderemezsin. Topluluk ve mesajları bu telefondan silinir; geri dönmek için yeniden istek gerekir."
          }
        }
      }
    },
    "confirm.leave.title": {
      "comment": "Leave confirmation title.",

    "disclosure.body": {
      "comment": "What the relay learns, before create/join/redeem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages are end-to-end encrypted to each member separately; the relay cannot read them. Unlike one-to-one chats, though, the relay sees who is in a community and who sends to whom. Public community names can be searched, and your search words reach the relay. Joining always needs the administrator's approval."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar her üyeye ayrı ayrı uçtan uca şifrelenir; sunucu içeriği okuyamaz. Ama bire bir sohbetlerden farklı olarak sunucu, topluluktaki üyeleri ve kimin kime mesaj gönderdiğini görür. Açık toplulukların adı aranabilir; aradığın sözcükler sunucuya ulaşır. Katılım her zaman yöneticinin onayıyla olur."
          }
        }
      }
    },
    "disclosure.private": {
      "comment": "What the relay learns, for a private community.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A private community does not appear in search; its name stays in the invitation code and on phones. Messages are end-to-end encrypted to each member separately. Unlike one-to-one chats, though, the relay still sees who is in it and who sends to whom. Joining always needs the administrator's approval."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli topluluk aramada görünmez; adı yalnızca davet kodunda ve telefonlarda durur. Mesajlar her üyeye ayrı ayrı uçtan uca şifrelenir. Ama bire bir sohbetlerden farklı olarak sunucu, topluluktaki üyeleri ve kimin kime mesaj gönderdiğini yine görür. Katılım her zaman yöneticinin onayıyla olur."
          }
        }
      }
    },
    "join.message": {
      "comment": "Join confirmation body.",
      "extractionState": "manual",
      "localizations": {

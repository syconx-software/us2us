      "comment": "No communities on this phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have no communities yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

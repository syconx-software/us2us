    "confirm.withdraw.message": {
      "comment": "Withdraw confirmation body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The administrator no longer sees your request, and the community is removed from this phone. The invitation you used will not work again."

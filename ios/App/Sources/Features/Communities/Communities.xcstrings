    "communities.footnote": {
      "comment": "Footnote under the communities screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages are end-to-end encrypted to each member separately; new members cannot see earlier messages. Backups do not include communities: after a restore, request a public community again or use a new invitation. Message history does not come back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar her üyeye ayrı ayrı uçtan uca şifrelenir; yeni üyeler önceki mesajları göremez. Yedekler toplulukları içermez: geri yüklemeden sonra açık topluluğa yeniden istek gönder ya da yeni bir davet kodu kullan. Mesaj geçmişi geri gelmez."
          }
        }
      }
    },
    "communities.title": {
      "comment": "Communities screen title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Communities"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topluluklar"
          }
        }
      }
    },
    "communities.unsupported": {
      "comment": "The relay has no community routes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This relay does not support communities yet. One-to-one chats are not affected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu henüz toplulukları desteklemiyor. Bire bir sohbetler etkilenmez."
          }
        }
      }
    },

        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli topluluk"
          }
        }
      }
    },
    "confirm.delete.message": {
      "comment": "Delete confirmation body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Members can no longer send; undelivered messages are deleted. The history is erased from this phone too. Copies on members' phones cannot be recalled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üyeler artık mesaj gönderemez; teslim edilmemiş mesajlar silinir. Mesaj geçmişi bu telefondan da silinir. Üyelerin telefonlarındaki kopyalar geri alınamaz."
          }
        }
      }
    },
    "confirm.delete.title": {
      "comment": "Delete confirmation title (owner).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this community for everyone?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topluluk herkes için silinsin mi?"
          }
        }
      }
    },
    "confirm.forget.message": {
      "comment": "Remove-from-phone confirmation body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The community and its messages are erased from this phone for good."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topluluk ve mesajları bu telefondan kalıcı olarak silinir."
          }
        }
      }
    },
    "confirm.forget.title": {
      "comment": "Remove-from-phone confirmation title.",
      "extractionState": "manual",

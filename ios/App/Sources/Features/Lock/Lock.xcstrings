{
  "sourceLanguage": "tr",
  "strings": {
    "lock.code.forgot": {
      "comment": "3.2 text button that opens 3.3.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu unuttum"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I forgot my code"
          }
        }
      }
    },
    "lock.code.throttled %@": {
      "comment": "3.2 while the keypad waits; the argument is a live mm:ss countdown.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla yanlış deneme. %@ sonra tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong attempts. Try again in %@."
          }
        }
      }
    },
    "lock.code.title": {
      "comment": "3.2 title above the six code dots.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli kodunu gir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your secret code"
          }
        }
      }
    },
    "lock.code.unavailable": {
      "comment": "3.2 when the vault could not be read right now (Secure Enclave or Keychain error, store not opened). Not a wrong code and not counted; no red dots.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerin şu an açılamadı. Kodun doğru olabilir; birkaç saniye sonra yeniden dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data couldn't be opened right now. Your code may be right; try again in a few seconds."
          }
        }
      }
    },
    "lock.code.unusable": {
      "comment": "3.2 when the vault can never be opened on this phone (device secret or hardware key gone, file damaged). Not a wrong code; points to 3.3 (lock.code.forgot).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon verilerinin kilidini artık açamıyor. Yedeğin varsa “Kodu unuttum” ile geri yükleyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can no longer unlock your data. If you have a backup, you can restore it from “I forgot my code”."
          }
        }
      }
    },
    "lock.code.wrong": {
      "comment": "3.2 after a wrong code when no further wait lies ahead.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod yanlış."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong code."
          }
        }
      }
    },
    "lock.code.wrong.warning %lld %@": {
      "comment": "3.2 after a wrong code: how many more wrong codes until a wait, and how long (e.g. “1 dakika”). Turkish has the plural forms too (same text) so the lookup never falls back to the English .stringsdict.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kod yanlış. %1$lld yanlış daha olursa %2$@ beklemen gerekir."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kod yanlış. %1$lld yanlış daha olursa %2$@ beklemen gerekir."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wrong code. %1$lld more wrong attempt and you'll have to wait %2$@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Wrong code. %1$lld more wrong attempts and you'll have to wait %2$@."
                }
              }
            }
          }
        }
      }
    },
    "lock.faceID.reason": {
      "comment": "Reason passed to the system biometric prompt (Face ID shows the Info.plist text instead).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "us2us'ı açmak için yüzünü kullanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your face to unlock us2us."
          }
        }
      }
    },
    "lock.faceID.retry": {
      "comment": "3.1 VoiceOver label of the Face ID disc (tapping it scans again).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID ile aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock with Face ID"
          }
        }
      }
    },
    "lock.faceID.subtitle": {
      "comment": "3.1 line under the status.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanımazsa gizli kodun istenir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it doesn't recognise you, your secret code is asked"
          }
        }
      }
    },
    "lock.faceID.title": {
      "comment": "3.1 status under the Face ID disc while the scan runs.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID ile açılıyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocking with Face ID"
          }
        }
      }
    },
    "lock.faceID.useCode": {
      "comment": "3.1 secondary button: go to the code keypad (3.2).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodla aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock with code"
          }
        }
      }
    },
    "lock.forgot.body": {
      "comment": "3.3 paragraph under the title.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli kodun hiçbir yere gönderilmez, hiçbir yerde saklanmaz. Sıfırlama bağlantısı, destek talebi ya da güvenlik sorusu yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your secret code is never sent or stored anywhere. There's no reset link, support request or security question."
          }
        }
      }
    },
    "lock.forgot.erase.body": {
      "comment": "3.3 danger option card description.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki tüm sohbetler ve anahtarlar kalıcı olarak silinir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All chats and keys on this device are permanently erased."
          }
        }
      }
    },
    "lock.forgot.erase.title": {
      "comment": "3.3 danger option card title (asks a second confirmation).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şeyi sil, baştan başla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase everything, start over"
          }
        }
      }
    },
    "lock.forgot.restore.body": {
      "comment": "3.3 option card description. Honest about what a backup holds: account and contacts, never message history (PROTOCOL §5.5).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifreli yedeğin ve parolasıyla hesabın ve kişilerin geri gelir. Mesaj geçmişi yedekte yok; bu telefondaki mesajlar silinir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your encrypted backup and its password, your account and contacts come back. Message history isn't in the backup; the messages on this phone are erased."
          }
        }
      }
    },
    "lock.forgot.restore.title": {
      "comment": "3.3 option card title (opens the backup file picker → 7.3).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekten geri yükle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore from backup"
          }
        }
      }
    },
    "lock.forgot.retry": {
      "comment": "3.3 secondary button: back to the code keypad.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar dene"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "lock.forgot.title": {
      "comment": "3.3 sheet title (Doto display).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod kurtarılamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code can't be recovered."
          }
        }
      }
    },
    "lock.touchID.reason": {
      "comment": "Reason shown in the system Touch ID prompt.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "us2us'ı açmak için parmak izini kullanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your fingerprint to unlock us2us."
          }
        }
      }
    },
    "lock.touchID.retry": {
      "comment": "3.1 VoiceOver label of the disc on Touch ID devices.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID ile aç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock with Touch ID"
          }
        }
      }
    },
    "lock.touchID.title": {
      "comment": "3.1 status on devices with Touch ID instead of Face ID.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID ile açılıyor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocking with Touch ID"
          }
        }
      }
    },
    "lock.wiped.body": {
      "comment": "Lock after the optional wipe: what happened and the two ways on.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli kod üst üste 10 kez yanlış girildi. Bu telefondaki tüm sohbetler, anahtarlar ve hesap ayarları kalıcı olarak silindi. Yedeğin ve parolası varsa hesabını ve kişilerini geri yükleyebilirsin; yoksa yeni bir hesapla baştan başla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The secret code was entered wrong 10 times in a row. All chats, keys and account settings on this phone were permanently erased. If you have a backup and its password, you can restore your account and contacts; otherwise, start over with a new account."
          }
        }
      }
    },
    "lock.wiped.restore.body": {
      "comment": "Lock after the wipe: under “Yedekten geri yükle”.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın ve kişilerin geri gelir; mesaj geçmişi yedekte yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and contacts come back; message history isn't in the backup."
          }
        }
      }
    },
    "lock.wiped.startOver.body": {
      "comment": "Lock after the wipe: under “Baştan başla” (relay retention, PROTOCOL §4.10).",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir hesap oluştur. Eski hesabın 180 gün hiç bağlanılmazsa kendiliğinden silinir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new account. The old one is removed automatically after 180 days without a connection."
          }
        }
      }
    },
    "lock.wiped.startOver.title": {
      "comment": "Lock after the wipe: option card that goes to 1.1.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baştan başla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start over"
          }
        }
      }
    },
    "lock.wiped.title": {
      "comment": "Lock, right after the optional wipe (the 10th wrong code in a row, PROTOCOL §5.2) fired. Proposed; Doto title.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler silindi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data was erased."
          }
        }
      }
    }
  },
  "version": "1.0"
}

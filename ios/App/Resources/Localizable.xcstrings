          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şeyi sil"
          }
        }
      }
    },
    "erase.confirm.body" : {
      "comment" : "3.3 second confirmation paragraph. The vault is locked (code forgotten), so the relay account cannot be deleted from here; 180 = the relay's INACTIVE_ACCOUNT_DAYS (PROTOCOL §4.10).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your chats, keys and settings will be permanently erased from this device. Your account stays on the server and messages sent to you won't reach you; it's removed automatically after 180 days without a connection. This can't be undone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbetlerin, anahtarların ve ayarların bu cihazdan kalıcı olarak silinecek. Hesabın sunucuda kalır ve sana yazılanlar sana ulaşmaz; 180 gün hiç bağlanılmazsa kendiliğinden silinir. Bu işlem geri alınamaz."
          }
        }
      }
    },
    "erase.confirm.title" : {
      "comment" : "3.3 second confirmation title (same floating sheet).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase everything?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey silinsin mi?"
          }
        }
      }
    },

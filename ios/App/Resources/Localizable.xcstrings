    "erase.confirm.action" : {
      "comment" : "3.3 second confirmation: the destructive button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase everything"
          }

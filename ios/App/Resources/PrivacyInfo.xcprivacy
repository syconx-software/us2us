<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No tracking, no tracking domains, no analytics, no push tokens. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  What leaves the phone in a form the relay can read (PROTOCOL.md §9): the
	  random relay account id (envelope recipient, media uploader, directory
	  lookups). Message content, media, contacts, profiles, presence and
	  location are end-to-end encrypted; the relay cannot read them, and
	  usernames reach it only as lookup keys, never in clear. IP addresses are
	  not logged or used to derive location. App Store Connect › App Privacy
	  must say the same (ios/App/README.md › Releasing).
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Theme and language preferences (AppPreferences), app-only. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!--
			  C617.1: size / metadata of the app's own files (fstat in the
			  linked libsignal and Foundation file handling, inside the
			  container only). 3B52.1: the creation date of the backup file the
			  user picks in the document picker (7.3 shows it).
			  SQLCipher.framework and SwiftProtobuf ship their own manifests.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
				<string>3B52.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

# /etc/systemd/system/us2us-relay.service
#
# Runs the built relay (.output/server/index.mjs) as the unprivileged user
# `us2us`. One process only: WebSocket sessions, the online fast path and the
# rate limits live in memory. See relay/README.md for the full setup.

[Unit]
Description=us2us blind relay and website
Documentation=https://us2us.app
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=us2us
Group=us2us
WorkingDirectory=/opt/us2us/relay
ExecStart=/usr/bin/node /opt/us2us/relay/.output/server/index.mjs
# Secrets and settings (DATABASE_URL, POW_SECRET, ...); root:us2us, mode 0640.
EnvironmentFile=/etc/us2us/relay.env
Environment=NODE_ENV=production TZ=UTC HOST=127.0.0.1 PORT=3000 TRUST_PROXY=1 MEDIA_DIR=/var/lib/us2us/media

# On SIGTERM the relay closes sockets with 1001, writes envelopes it still
# holds in memory to MySQL and exits; Nitro allows itself 30 s for that.
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=always
RestartSec=2
LimitNOFILE=65536

# /var/lib/us2us (media blobs) is created and owned by the service user.
StateDirectory=us2us
StateDirectoryMode=0700
UMask=0077

# Hardening. MemoryDenyWriteExecute stays off: V8's JIT needs W+X pages.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

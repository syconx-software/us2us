# us2us relay configuration.
#
# `nuxt dev` reads a `.env` file; the built server (.output/server/index.mjs)
# does not, so in production these come from the systemd EnvironmentFile
# (see deploy/us2us-relay.service). Only DATABASE_URL and POW_SECRET are
# required; everything else shows its default.

# --- Server -----------------------------------------------------------------
# Bind to loopback and let nginx terminate TLS. NITRO_PORT / NITRO_HOST work too.
HOST=127.0.0.1
PORT=3000

# --- Database (MySQL 8.4 LTS or 9.x) -----------------------------------------
DATABASE_URL=mysql://us2us:change-me@127.0.0.1:3306/us2us
DB_POOL_SIZE=10

# --- Proof-of-work (PROTOCOL.md §4.2) -----------------------------------------
# HMAC key for the stateless challenges, at least 32 characters.
# Generate with: openssl rand -base64 48
POW_SECRET=
POW_DIFFICULTY_REGISTER=22
# The registration difficulty rises one bit each time registrations in the
# last hour double past this many, up to the maximum (0 keeps it fixed).
POW_REGISTER_ADAPT_PER_HOUR=120
POW_DIFFICULTY_REGISTER_MAX=26
POW_DIFFICULTY_MESSAGE=18
POW_TTL_SECONDS=600

# --- Mailbox and WebSocket (§1.1, §4.6, §4.7) ---------------------------------
ENVELOPE_MAX_BYTES=65536
ENVELOPE_TTL_DAYS=14
# Online fast path: an envelope sent to a connected client is written to
# MySQL only if the client has not acknowledged it within this time.
WS_ACK_TIMEOUT_MS=10000
# Per recipient: envelopes beyond these (count, body bytes) are refused with
# 429 until the recipient fetches and acknowledges its mailbox.
MAILBOX_MAX_ENVELOPES=10000
MAILBOX_MAX_BYTES=52428800
# The part of a mailbox that first contacts (proof-of-work, no access key)
# may fill, at most half: strangers cannot lock out the recipient's contacts.
MAILBOX_POW_MAX_ENVELOPES=500
MAILBOX_POW_MAX_BYTES=8388608
# Sockets silent for longer than this are dropped (clients ping every ~30 s).
WS_IDLE_TIMEOUT_MS=90000
WS_MAX_FRAME_BYTES=32768

# --- Media (§4.9) --------------------------------------------------------------
# Must be writable by the service user; keep nginx's client_max_body_size in sync.
# Used by the relay alone: blob files in it without a media row are deleted.
MEDIA_DIR=/var/lib/us2us/media
MEDIA_MAX_BYTES=67108864
MEDIA_TTL_DAYS=14
# Below this much free space (MiB) on MEDIA_DIR's file system (normally also
# MySQL's), uploads and stored envelopes are refused with 503 instead of
# filling the disk. 0 disables the check.
DISK_MIN_FREE_MB=1024
# Uploads stop this much (MiB) above the floor, so that only envelopes can
# use the last of it: media can never stop message delivery.
DISK_ENVELOPE_RESERVE_MB=2048
# Unexpired media one account may keep (MiB), lower while it is younger than
# NEW_ACCOUNT_DAYS (0 disables the new-account limits).
MEDIA_STORED_MAX_MB=2048
MEDIA_STORED_MAX_NEW_MB=256
NEW_ACCOUNT_DAYS=7

# --- Accounts and retention (§3.3, §4.10) -------------------------------------
USERNAME_HOLD_DAYS=14
INACTIVE_ACCOUNT_DAYS=180
# How often expired data is swept.
RETENTION_INTERVAL_SECONDS=300

# --- Rate limits (§4.11), "<count>/<sec|min|hour|day>" or "off" ---------------
# Per client IP:
RATE_LIMIT_POW=30/min
RATE_LIMIT_REGISTER=5/hour
# Per IPv6 /48 (IPv4: per address), and for the whole relay (only
# registrations with a valid proof-of-work spend the latter).
RATE_LIMIT_REGISTER_PREFIX=20/hour
RATE_LIMIT_REGISTER_GLOBAL=1000/hour
RATE_LIMIT_SEND=600/min
# Per recipient and IP (kept in memory under a MAC, never stored): proof-of-work
# sends, and bytes of every stored send.
RATE_LIMIT_SEND_PAIR_POW=60/hour
RATE_LIMIT_SEND_PAIR_BYTES=33554432/hour
# Envelopes in POST /v1/messages/ephemeral batches (presence fan-out); at least 200.
RATE_LIMIT_EPHEMERAL=3000/min
RATE_LIMIT_MEDIA_FETCH=600/min
RATE_LIMIT_WS_CONNECT=60/min
# Failed X-Auth-Token checks (401s); an IP over it gets 429 for every
# authenticated request, before its token is looked up.
RATE_LIMIT_AUTH_FAIL=30/min
# Per account:
RATE_LIMIT_DIRECTORY=60/hour
# Avatar records for search (§4.12): fetches (a 304 counts), stores, and
# deletes on a budget of their own, so "Show in search" off never waits.
RATE_LIMIT_AVATAR_FETCH=60/hour
RATE_LIMIT_AVATAR_WRITE=30/day
RATE_LIMIT_AVATAR_DELETE=200/day
RATE_LIMIT_KEY_FETCH=120/hour
# Per target account: bundles with one-time keys; beyond, the signed and
# last-resort keys only, so one-time keys cannot be drained.
RATE_LIMIT_KEY_TARGET=60/hour
RATE_LIMIT_MEDIA_UPLOADS=60/hour
# Bytes uploaded per account per day (2 GiB).
RATE_LIMIT_MEDIA_BYTES=2147483648/day
# Accounts younger than NEW_ACCOUNT_DAYS, and the whole relay (then 503).
RATE_LIMIT_MEDIA_BYTES_NEW=536870912/day
RATE_LIMIT_MEDIA_BYTES_GLOBAL=25769803776/day
# Community deliveries per sender and recipient, tombstones included.
RATE_LIMIT_COMMUNITY_PAIR=5000/day
RATE_LIMIT_USERNAME_CHANGES=5/day
RATE_LIMIT_WS_FRAMES=1200/min
# Any authenticated request.
RATE_LIMIT_ACCOUNT=1200/min

# --- Privacy ---------------------------------------------------------------------
# Take the client IP from the proxy's header. Enable only behind your own
# proxy (the nginx config in deploy/ sets both headers); the header is
# believed only on connections from TRUST_PROXY_FROM, so clients that reach
# the port directly cannot choose their own rate-limit bucket.
TRUST_PROXY=0
TRUST_PROXY_FROM=127.0.0.1,::1
# x-forwarded-for (right-most entry) or x-real-ip.
TRUST_PROXY_HEADER=x-forwarded-for
# Client IPs are never logged. With 1, a request refused by a per-IP rate
# limit is logged with its IP (to investigate abuse); keep it off normally.
LOG_IPS=0
# error | warn | info | debug
LOG_LEVEL=info

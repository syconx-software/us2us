<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The relay is the only network endpoint. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 6.2 QR scanning and photos or videos from the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice notes. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Location and live location, only while a share is running. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Never asked for: saving to the gallery on Android 9 only writes (WRITE_EXTERNAL_STORAGE,
         maxSdkVersion 28, in feature/media). The manifest merger would otherwise add it. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- The invite channels (WhatsApp, mail, SMS). -->
    <queries>
        <package android:name="com.whatsapp" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <!-- Nothing leaves the phone through Android's backup or device transfer: the backup is the
         app's own encrypted file (7.2). Predictive back is on from Android 13: the screens follow the
         back gesture as it moves, as they already do on Android 16. -->
    <application
        android:name=".app.Us2usApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="us2us"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Us2us"
        tools:targetApi="36">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invite links: https://us2us.app/u/<username>. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="us2us.app" />
                <data android:pathPrefix="/u/" />
            </intent-filter>
        </activity>

        <!-- Disappearing messages and Ghost wipes that fall due while the app is closed: the runtime
             schedules an alarm when the app leaves, and this receiver runs the locked-path wipe
             (inexact without the exact-alarm permission; the next launch wipes in any case). -->
        <receiver
            android:name="com.syconx.us2us.runtime.facade.BackgroundWipeReceiver"
            android:exported="false" />

        <!-- Per-app language (7.1 › Dil) on API 28–32; Android 13+ keeps it itself. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android-only copy: the notification of the foreground service that keeps a live-location share
     going in the background (PROTOCOL §8.3). It never names the contact or shows anything from the
     chat; iOS shows its own location indicator instead. -->
<resources>
    <!-- The notification channel (system settings). -->
    <string name="live_sharing_channel">Canlı konum</string>
    <string name="live_sharing_channel_description">Canlı konumunu paylaşırken görünür. Kiminle paylaştığını söylemez.</string>
    <string name="live_sharing_title">Konumun paylaşılıyor</string>
    <!-- The minutes left until the last share ends, as the bubble says it. -->
    <string name="live_sharing_remaining">%d dk kaldı</string>
    <!-- Stops every live-location share. -->
    <string name="live_sharing_stop">Durdur</string>
</resources>

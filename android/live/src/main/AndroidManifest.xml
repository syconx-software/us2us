<?xml version="1.0" encoding="utf-8"?>
<!-- The live service talks to the relay (and watches the network to reconnect at once). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- “+” › Konum and live location, while in use only (never in the background on its own). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Live location goes on in the background only while the user shares it (PROTOCOL §8.3): a
         foreground service of type location, started from the conversation, with its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The 30-second grace period, the teardown after it and the end of a share run on time while
         the screen is off: short partial wake locks, never longer than a minute. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name=".LiveSharingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>

    <!-- settings.erase -->
    <string name="settings_erase">Erase everything</string>
    <!-- settings.erase.confirm.action — 7.1 erase confirmation, the danger button: deletes the account on the relay, then this phone. -->
    <string name="settings_erase_confirm_action">Delete account and everything</string>
    <!-- settings.erase.confirm.body — 7.1 “Her şeyi sil” second confirmation paragraph: the account is deleted on the relay too (the relay frees the username at once, PROTOCOL §4.3). -->
    <string name="settings_erase_confirm_body">Your account and username will be permanently deleted from the server, and your chats, keys and settings from this phone. No one will be able to reach you, and your username will be free for others right away. This can\'t be undone.</string>
    <!-- settings.erase.confirm.title — 7.1 “Her şeyi sil” second confirmation title (Doto display): the account is deleted on the relay too. 3.3's local-only confirmation keeps “Her şey silinsin mi?” (erase.confirm.title). -->
    <string name="settings_erase_confirm_title">Delete your account?</string>
    <!-- settings.erase.confirm.working — 7.1 erase confirmation: the danger button (or “Tekrar dene”) while the relay deletes the account. -->
    <string name="settings_erase_confirm_working">Deleting account…</string>
    <!-- settings.erase.failed.body — 7.1 erase sheet when the relay did not confirm the deletion (offline, timeout, server error). Only this phone is known to be untouched: the relay may have deleted the account just before the connection dropped (“Tekrar dene” then succeeds). -->
    <string name="settings_erase_failed_body">The server didn\'t confirm the deletion. Nothing on this phone was erased; check your connection and try again.</string>
    <!-- settings.erase.failed.title — 7.1 erase sheet title when the relay did not delete the account (Doto display). -->
    <string name="settings_erase_failed_title">The account wasn\'t deleted.</string>
    <!-- settings.erase.footnote — 7.1 under “Her şeyi sil”. A restore needs the account on the relay, so a deleted account cannot come back from a backup; exported backup files stay where the user saved them. -->
    <string name="settings_erase_footnote">Your account and username are permanently deleted from the server, and your chats, keys and settings from this phone. A deleted account can\'t be restored from a backup either. Backup files you exported stay in Files and can no longer be used; you can delete them yourself.</string>
    <!-- settings.erase.retry — 7.1 erase sheet after a failure: deletes the account on the relay again. -->
    <string name="settings_erase_retry">Try again</string>
    <!-- settings.erase.thisPhone.body — 7.1 erase sheet after a failure, option card description. Contacts can still write to the abandoned account; their messages never arrive. 180 = the relay's INACTIVE_ACCOUNT_DAYS (PROTOCOL §4.10). -->
    <string name="settings_erase_thisphone_body">Your account and username stay on the server, and messages sent to you won\'t reach you. The account is removed automatically after 180 days without a connection.</string>
    <!-- settings.erase.thisPhone.title — 7.1 erase sheet after a failure, danger option card: erases this phone, leaves the account on the relay. -->
    <string name="settings_erase_thisphone_title">Erase from this phone only</string>
